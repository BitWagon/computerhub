# MongoDB
MONGODB_URI=mongodb+srv://salman248shah:salman248shah@cluster0.qpbmo.mongodb.net/ComputerHub

# JWT
JWT_SECRET=your_long_random_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Client Upload
NEXT_PUBLIC_CLOUDINARY_URL=https://api.cloudinary.com/v1_1/your_cloud_name/image/upload
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=computerhub

# Optional Server Upload
CLOUDINARY_URL=https://api.cloudinary.com/v1_1/your_cloud_name/image/upload
CLOUDINARY_UPLOAD_PRESET=computerhub

# Application
NEXT_PUBLIC_APP_NAME=ComputerHub
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Admin
ADMIN_EMAIL=andrewstone4089@gmail.com